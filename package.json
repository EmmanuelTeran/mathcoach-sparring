{
  "name": "mathcoach-sparring",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de Active Recall multimodal y Spaced Repetition (SRS SM-2) para aprendizaje de matemáticas en 3 niveles",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "test:server": "npm --workspace=server test",
    "test:client": "npm --workspace=client test",
    "test": "npm run test:server && npm run test:client",
    "test:e2e": "LD_LIBRARY_PATH=\"${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/home/teran/.local/lib/usr/lib/x86_64-linux-gnu\" playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "concurrently": "^9.1.2"
  }
}
